{
  "name": "checkout-ui-custom",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "lint": "biome lint .",
    "format": "biome format .",
    "cy-r": "cd cy-runner && node cy-runner",
    "install:checkout": "cd checkout-ui-custom && yarn && cd ../",
    "start:checkout": "cd checkout-ui-custom && yarn watch",
    "build:checkout": "cd checkout-ui-custom && yarn build && cd ../",
    "lint:fix": "biome lint --fix .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --fix .",
    "biome:ci": "biome ci ."
  },
  "lint-staged": {
    "*.{ts,js,tsx,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,graphql,gql}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.5",
    "@sdsla/biome-config": "git+ssh://git@bitbucket.org/sdsla/sdsla-biome-config.git#master",
    "@types/node": "^12.12.21",
    "lint-staged": "^10.0.2",
    "typescript": "^3.7.5"
  }
}
